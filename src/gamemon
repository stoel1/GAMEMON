#!/usr/bin/env bash

# ============================================================
# GAMEMON - RHEL 10
# Intel Core i9-13900K / ASRock Z790 LiveMixer
# NVIDIA GeForce RTX 5070
# ============================================================

set -u

REFRESH=1

declare -A PREV_TOTAL PREV_IDLE
declare -A CPU_USAGE
declare -A P_TEMP E_TEMP
declare -A BOARD_TEMP FAN_RPM


CPU_TOTAL=0
PACKAGE_TEMP="N/A"
HOTTEST_CORE="N/A"
AVG_FREQ=0
VCORE="N/A"


GPU_UTIL="N/A"
GPU_TEMP="N/A"
GPU_CORE="N/A"
GPU_MEM_CLOCK="N/A"
GPU_POWER="N/A"
VRAM_USED="N/A"
VRAM_TOTAL="N/A"

# ============================================================
# TERMINAL
# ============================================================

cleanup() {
    tput cnorm 2>/dev/null
    tput rmcup 2>/dev/null
    printf '\n'
}

trap cleanup EXIT
trap 'exit 0' INT TERM

tput smcup 2>/dev/null
tput civis 2>/dev/null
tput clear

ROW=0

put() {
    local text="$1"
    local cols rows

    cols=$(tput cols)
    rows=$(tput lines)

    (( ROW >= rows )) && return

    tput cup "$ROW" 0

    if (( cols > 1 )); then
        printf '%-*.*s\033[K' \
            "$((cols - 1))" "$((cols - 1))" "$text"
    fi

    ROW=$((ROW + 1))
}

# ============================================================
# CPU GEBRUIK VIA /proc/stat
# ============================================================

update_cpu_usage() {

    local line name total idle i
    local delta_total delta_idle usage

    while IFS= read -r line; do

        read -ra fields <<< "$line"
        name="${fields[0]}"

        [[ "$name" =~ ^cpu([0-9]+)?$ ]] || continue

        total=0

        for ((i=1; i<=8; i++)); do
            total=$((total + fields[i]))
        done

        idle=$((fields[4] + fields[5]))

        if [[ -n "${PREV_TOTAL[$name]+x}" ]]; then

            delta_total=$((total - PREV_TOTAL[$name]))
            delta_idle=$((idle - PREV_IDLE[$name]))

            if (( delta_total > 0 )); then
                usage=$((100 * (delta_total - delta_idle) / delta_total))
            else
                usage=0
            fi
        else
            usage=0
        fi

        PREV_TOTAL[$name]=$total
        PREV_IDLE[$name]=$idle

        if [[ "$name" == "cpu" ]]; then
            CPU_TOTAL=$usage
        else
            CPU_USAGE["${name#cpu}"]=$usage
        fi

    done < /proc/stat
}

# ============================================================
# CPU TEMPERATURES VIA HWMON
# ============================================================

read_cpu_temperatures() {

    P_TEMP=()
    E_TEMP=()

    PACKAGE_TEMP="N/A"
    HOTTEST_CORE=-100

    local hw name file base label value core

    for hw in /sys/class/hwmon/hwmon*; do

        [[ -r "$hw/name" ]] || continue
        name=$(cat "$hw/name")

        [[ "$name" == "coretemp" ]] || continue

        for file in "$hw"/temp*_input; do

            [[ -r "$file" ]] || continue

            base="${file%_input}"
            label=$(cat "${base}_label" 2>/dev/null || true)
            value=$(cat "$file" 2>/dev/null || echo 0)

            value=$((value / 1000))

            if [[ "$label" == "Package id 0" ]]; then
                PACKAGE_TEMP="$value"
                continue
            fi

            if [[ "$label" =~ ^Core[[:space:]]+([0-9]+)$ ]]; then

                core="${BASH_REMATCH[1]}"

                if (( value > HOTTEST_CORE )); then
                    HOTTEST_CORE=$value
                fi

                case "$core" in
                    0|4|8|12|16|20|24|28)
                        P_TEMP[$core]=$value
                        ;;
                    3[2-9]|4[0-7])
                        E_TEMP[$core]=$value
                        ;;
                esac
            fi
        done
    done

    [[ "$HOTTEST_CORE" == "-100" ]] && HOTTEST_CORE="N/A"
}

# ============================================================
# MOEDERBORD / VCORE / VENTILATOREN
# ============================================================

read_board_sensors() {

    BOARD_TEMP=()
    FAN_RPM=()
    VCORE="N/A"

    local hw name file base label value
    local VCORE_MV

    for hw in /sys/class/hwmon/hwmon*; do

        [[ -r "$hw/name" ]] || continue
        name=$(cat "$hw/name")

        [[ "$name" == "nct6798" ]] || continue

        # CPU Vcore - NCT6798D in0
        if [[ -r "$hw/in0_input" ]]; then

            VCORE_MV=$(cat "$hw/in0_input")

            printf -v VCORE '%d.%03d' \
                "$((VCORE_MV / 1000))" \
                "$((VCORE_MV % 1000))"
        fi

        # Moederbordtemperaturen
        for file in "$hw"/temp*_input; do

            [[ -r "$file" ]] || continue

            base="${file%_input}"
            label=$(cat "${base}_label" 2>/dev/null || true)
            value=$(cat "$file" 2>/dev/null || echo 0)

            value=$((value / 1000))

            (( value <= 0 )) && continue

            case "$label" in
                SYSTIN|AUXTIN0|AUXTIN1|AUXTIN2|AUXTIN3|AUXTIN4|"PECI Agent 0")
                    BOARD_TEMP["$label"]=$value
                    ;;
            esac
        done

        # Ventilatorsnelheden
        for file in "$hw"/fan*_input; do

            [[ -r "$file" ]] || continue

            base="${file%_input}"
            label=$(basename "$base")
            value=$(cat "$file" 2>/dev/null || echo 0)

            FAN_RPM["$label"]=$value
        done
    done
}

# ============================================================
# CPU FREQUENTIE VIA SYSFS
# ============================================================

read_cpu_frequency() {
    local file value sum=0 count=0
    for file in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
        [[ -r "$file" ]] || continue
        read -r value < "$file"
        [[ "$value" =~ ^[0-9]+$ ]] || continue
        sum=$((sum + value))
        count=$((count + 1))
    done
    if (( count > 0 )); then
        AVG_FREQ=$(awk -v s="$sum" -v c="$count" 'BEGIN {printf "%.0f", s/c/1000}')
    else
        AVG_FREQ=$(awk '/^cpu MHz/ {sum += $4; count++} END {if (count) printf "%.0f", sum/count; else print 0}' /proc/cpuinfo)
    fi
}

# ============================================================
# CPU C-STATES VIA SYSFS (GEEN ROOT NODIG)
# ============================================================

declare -A CPUIDLE_PREV
CPUIDLE_PREV_NS=0
CSTATE_C1="N/A"
CSTATE_C2="N/A"
CSTATE_C3="N/A"

read_cpuidle() {
    local file value old name state now_ns elapsed_ns delta pct cpu
    local c1_sum=0 c2_sum=0 c3_sum=0 c1_count=0 c2_count=0 c3_count=0
    now_ns=$(date +%s%N)
    elapsed_ns=0
    if (( CPUIDLE_PREV_NS > 0 )); then elapsed_ns=$((now_ns - CPUIDLE_PREV_NS)); fi

    for file in /sys/devices/system/cpu/cpu[0-9]*/cpuidle/state*/time; do
        [[ -r "$file" ]] || continue
        read -r value < "$file"
        [[ "$value" =~ ^[0-9]+$ ]] || continue
        name=$(<"${file%/time}/name")
        state="${name%%_*}"
        cpu=$(printf '%s' "$file" | grep -oE 'cpu[0-9]+' | head -1)
        [[ -n "$cpu" ]] || continue

        if [[ -n "${CPUIDLE_PREV[$file]+x}" ]] && (( elapsed_ns > 0 )); then
            old=${CPUIDLE_PREV[$file]}
            delta=$((value - old))
            (( delta < 0 )) && delta=0
            pct=$(awk -v d="$delta" -v e="$elapsed_ns" 'BEGIN {if (e > 0) printf "%.4f", d*1000000/e; else print 0}')
            case "$state" in
                C1) c1_sum=$(awk -v a="$c1_sum" -v b="$pct" 'BEGIN {printf "%.4f",a+b}'); ((c1_count++)) ;;
                C2) c2_sum=$(awk -v a="$c2_sum" -v b="$pct" 'BEGIN {printf "%.4f",a+b}'); ((c2_count++)) ;;
                C3) c3_sum=$(awk -v a="$c3_sum" -v b="$pct" 'BEGIN {printf "%.4f",a+b}'); ((c3_count++)) ;;
            esac
        fi
        CPUIDLE_PREV[$file]=$value
    done

    CPUIDLE_PREV_NS=$now_ns
    (( c1_count > 0 )) && CSTATE_C1=$(awk -v s="$c1_sum" -v n="$c1_count" 'BEGIN {printf "%.1f",s/n}')
    (( c2_count > 0 )) && CSTATE_C2=$(awk -v s="$c2_sum" -v n="$c2_count" 'BEGIN {printf "%.1f",s/n}')
    (( c3_count > 0 )) && CSTATE_C3=$(awk -v s="$c3_sum" -v n="$c3_count" 'BEGIN {printf "%.1f",s/n}')
}

# ============================================================
# NVIDIA GPU
# ============================================================

read_gpu() {

    command -v nvidia-smi >/dev/null 2>&1 || return

    local data

    data=$(nvidia-smi \
        --query-gpu=utilization.gpu,temperature.gpu,clocks.gr,clocks.mem,power.draw,memory.used,memory.total \
        --format=csv,noheader,nounits 2>/dev/null) || return

    IFS=',' read -r \
        GPU_UTIL GPU_TEMP GPU_CORE GPU_MEM_CLOCK \
        GPU_POWER VRAM_USED VRAM_TOTAL <<< "$data"

    GPU_UTIL="${GPU_UTIL// /}"
    GPU_TEMP="${GPU_TEMP// /}"
    GPU_CORE="${GPU_CORE// /}"
    GPU_MEM_CLOCK="${GPU_MEM_CLOCK// /}"
    GPU_POWER="${GPU_POWER// /}"
    VRAM_USED="${VRAM_USED// /}"
    VRAM_TOTAL="${VRAM_TOTAL// /}"
}

# ============================================================
# RAM / SWAP
# ============================================================

read_memory() {

    read -r MEM_TOTAL MEM_AVAILABLE SWAP_TOTAL SWAP_FREE < <(
        awk '
            /^MemTotal:/     {mt=$2}
            /^MemAvailable:/ {ma=$2}
            /^SwapTotal:/    {st=$2}
            /^SwapFree:/     {sf=$2}
            END {print mt, ma, st, sf}
        ' /proc/meminfo
    )

    RAM_USED=$(awk -v t="$MEM_TOTAL" -v a="$MEM_AVAILABLE" \
        'BEGIN {printf "%.1f", (t-a)/1048576}')

    RAM_TOTAL=$(awk -v t="$MEM_TOTAL" \
        'BEGIN {printf "%.1f", t/1048576}')

    RAM_PERCENT=$((100 * (MEM_TOTAL - MEM_AVAILABLE) / MEM_TOTAL))

    SWAP_USED=$(awk -v t="$SWAP_TOTAL" -v f="$SWAP_FREE" \
        'BEGIN {printf "%.1f", (t-f)/1048576}')

    SWAP_TOTAL_GB=$(awk -v t="$SWAP_TOTAL" \
        'BEGIN {printf "%.1f", t/1048576}')
}

# ============================================================
# LOGISCHE PROCESSORS
# ============================================================

format_cpu_usage() {

    local start=$1
    local end=$2
    local cpu value
    local output=""

    for ((cpu=start; cpu<=end; cpu++)); do

        value="${CPU_USAGE[$cpu]:-0}"

        printf -v item "CPU%-2d:%3s%%" "$cpu" "$value"

        output+="$item  "
    done

    printf '%s' "$output"
}

# ============================================================
# P-CORES
# ============================================================

format_p_cores() {

    local output="P-cores: "
    local core

    for core in 0 4 8 12 16 20 24 28; do

        output+="P${core}:"
        output+="${P_TEMP[$core]:-N/A}C  "
    done

    printf '%s' "$output"
}

# ============================================================
# E-CORES
# ============================================================

format_e_cores() {

    local start=$1
    local end=$2
    local core
    local output=""

    for ((core=start; core<=end; core++)); do

        output+="E${core}:"
        output+="${E_TEMP[$core]:-N/A}C  "
    done

    printf '%s' "$output"
}

# ============================================================
# HOOFDSCHERM
# ============================================================

render() {

    ROW=0

    local cpu_model
    local fans temps
    local fan
    local time_now
    local label

    cpu_model=$(awk -F ': ' '/model name/ {print $2; exit}' /proc/cpuinfo)
    time_now=$(date '+%H:%M:%S')

    # Sensoren uitlezen
    update_cpu_usage
    read_cpu_temperatures
    read_board_sensors
    read_cpu_frequency
    read_cpuidle
    read_gpu
    read_memory

    # --------------------------------------------------------
    # HEADER
    # --------------------------------------------------------

    put "============================ GAMEMON ============================"
    put "Host: $(hostname) | Kernel: $(uname -r) | $time_now"
    put "------------------------------------------------------------------"

    # --------------------------------------------------------
    # CPU
    # --------------------------------------------------------

    put "CPU - $cpu_model"

    put "CPU Usage: ${CPU_TOTAL}%"

    put "Package: ${PACKAGE_TEMP} C | Hottest Core: ${HOTTEST_CORE} C | Average Frequency: ${AVG_FREQ} MHz"

    put "CPU Vcore (NCT6798D): ${VCORE} V"

    put "CPU idle states (gemiddelde per logische CPU): C1 ${CSTATE_C1}% | C2 ${CSTATE_C2}% | C3 ${CSTATE_C3}%"

    put "LOGICAL PROCESSORS"

    put "$(format_cpu_usage 0 7)"
    put "$(format_cpu_usage 8 15)"
    put "$(format_cpu_usage 16 23)"
    put "$(format_cpu_usage 24 31)"

    put "$(format_p_cores)"

    put "$(format_e_cores 32 39)"
    put "$(format_e_cores 40 47)"

    put "------------------------------------------------------------------"

    # --------------------------------------------------------
    # MOEDERBORD
    # --------------------------------------------------------

    put "MOTHERBOARD / COOLING"

    fans="Fans: "

    for fan in fan1 fan2 fan3 fan4 fan5 fan6 fan7; do

        fans+="${fan}: ${FAN_RPM[$fan]:-N/A} RPM  "
    done

    put "$fans"

    temps="Board temperatures: "

    for label in SYSTIN AUXTIN0 AUXTIN1 AUXTIN2 AUXTIN3 "PECI Agent 0" AUXTIN4; do

        if [[ -n "${BOARD_TEMP[$label]+x}" ]]; then
            temps+="${label}: ${BOARD_TEMP[$label]} C  "
        fi
    done

    put "$temps"

    put "------------------------------------------------------------------"

    # --------------------------------------------------------
    # NVIDIA GPU
    # --------------------------------------------------------

    put "NVIDIA GPU"

    put "GPU Usage: ${GPU_UTIL}% | Temperature: ${GPU_TEMP} C | Core Clock: ${GPU_CORE} MHz"

    put "Memory Clock: ${GPU_MEM_CLOCK} MHz | Power: ${GPU_POWER} W"

    put "VRAM: ${VRAM_USED} / ${VRAM_TOTAL} MiB"

    put "------------------------------------------------------------------"

    # --------------------------------------------------------
    # MEMORY
    # --------------------------------------------------------

    put "MEMORY"

    put "RAM: ${RAM_USED} / ${RAM_TOTAL} GiB (${RAM_PERCENT}%)"

    put "Swap: ${SWAP_USED} / ${SWAP_TOTAL_GB} GiB"

    put "------------------------------------------------------------------"

    put "Refresh: ${REFRESH}s | CTRL+C to exit"

    tput cup "$ROW" 0
    printf '\033[J'
}

# ============================================================
# START
# ============================================================

update_cpu_usage

while true; do

    render
    sleep "$REFRESH"

done
